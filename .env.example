# Supabase Project Settings > API. Public/anon key only; never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Configure your matching Supabase Auth Site URL and redirect allowlist separately.

# Server-only key used by the optional dashboard finance insight. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Server-only infonits.io agent lead webhook. Use a long random secret and the
# organization UUID used by the Finance workspace. Never expose either key to browser code.
SUPABASE_SERVICE_ROLE_KEY=
INFONITS_AGENT_WEBHOOK_SECRET=
INFONITS_AGENT_ORGANIZATION_ID=

# Optional dedicated HMAC key for WordPress Website Care tokens. If omitted,
# the server-only Supabase service role key is used. CRON_SECRET strengthens
# scheduled endpoint authorization; Vercel Cron sends it as a Bearer token when configured.
WEBSITE_MONITOR_SECRET=
CRON_SECRET=
